{
  "name": "Docker Compose Backup with Notification",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAt": "02:00",
              "field": "03:00"
            }
          ]
        }
      },
      "id": "e1a1f7f0-0000-0000-0000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "command": "cd /opt/traefik && tar czf /backups/traefik-$(date +%Y%m%d-%H%M%S).tar.gz .env docker-compose.yml traefik.yml dynamic/ 2>/dev/null || echo 'BACKUP_FAILED'",
        "cwd": "/opt/traefik"
      },
      "id": "e1a1f7f0-0000-0000-0000-000000000002",
      "name": "Backup Docker Config",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "command": "find /backups -name '*.tar.gz' -mtime +7 -delete && ls -la /backups/ | wc -l",
        "cwd": "/backups"
      },
      "id": "e1a1f7f0-0000-0000-0000-000000000003",
      "name": "Cleanup Old Backups",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "BACKUP_FAILED",
              "operator": {
                "type": "notContains",
                "operation": "notContains"
              }
            }
          ]
        }
      },
      "id": "e1a1f7f0-0000-0000-0000-000000000004",
      "name": "Backup Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "✅ Docker backup completed successfully\n\nTimestamp: {{ $now }}\nFiles kept: {{ $json.stdout }} backups",
        "options": {}
      },
      "id": "e1a1f7f0-0000-0000-0000-000000000005",
      "name": "Success Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1050,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-creds",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "🚨 Docker backup FAILED\n\nTimestamp: {{ $now }}\nCheck server immediately.",
        "options": {}
      },
      "id": "e1a1f7f0-0000-0000-0000-000000000006",
      "name": "Failure Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1050,
        400
      ],
      "credentials": {
        "telegramApi": {
          "id": "telegram-creds",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Backup Docker Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backup Docker Config": {
      "main": [
        [
          {
            "node": "Cleanup Old Backups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cleanup Old Backups": {
      "main": [
        [
          {
            "node": "Backup Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backup Success?": {
      "main": [
        [
          {
            "node": "Success Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Failure Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "backup",
      "id": "tag-backup"
    },
    {
      "name": "docker",
      "id": "tag-docker"
    }
  ]
}